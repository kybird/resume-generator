# === Global Configuration ===
# Choose one provider: openai, groq, google, antigravity, local
LLM_PROVIDER=openai

# === OpenAI Configuration ===
# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# === Groq Configuration ===
# Required if LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama3-70b-8192

# === Google (Gemini) Configuration ===
# Required if LLM_PROVIDER=google
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-1.5-pro

# === Antigravity Configuration ===
# Required if LLM_PROVIDER=antigravity
# Auth: Uses 'gcloud auth print-access-token' automatically if installed.
# Token: Saved to ~/.antigravity_token.json.
# Optional: Set manual token here if gcloud is not available
ANTIGRAVITY_ACCESS_TOKEN=
# Model Aliases: gemini, flash, claude, opus
LLM_MODEL=gemini
# Mode: plan (High Thinking), fast (Low Thinking), <empty> (Default)
LLM_MODE=plan

# === Local LLM Configuration ===
# Required if LLM_PROVIDER=local
# Point this to your local server endpoint.
# For Oobabooga/text-generation-webui: http://localhost:5000/v1/completions
# For llama.cpp server: http://localhost:8080/completion (Legacy) or http://localhost:8080/v1/chat/completions (OpenAI)
# Note: Current LocalClient implementation sends simple prompt payload, best suited for /completion or /v1/completions
LOCAL_LLM_URL=http://localhost:8080/completion
